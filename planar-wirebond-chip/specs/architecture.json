{
  "project_name": "planar-wirebond-chip",
  "version": "1.0.0",
  "author": "Indhirajith",
  "license": "Open Source",
  "description": "Single-planar-layer silicon superconducting transmon qubit chip with perimeter wire-bonding packaging specification",
